rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Itens de Estoque
    match /items/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    // Movimentações de Estoque
    match /movements/{movementId} {
      allow read: if true;
      allow create: if isValidId(movementId);
      allow update, delete: if isValidId(movementId);
    }

    // Requisições
    match /requisitions/{requisitionId} {
      allow read: if true;
      allow write: if isValidId(requisitionId);
    }

    // Funcionários
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isValidId(employeeId);
    }

    // Usuários
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }
  }
}
